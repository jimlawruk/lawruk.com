<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>client-app\</SpaRoot>
  </PropertyGroup>

  <!-- Exclude folders that should never appear in publish output -->
  <ItemGroup>
    <Content Remove="publish\**" />
    <Content Remove="client-app\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="publish\**" />
    <None Remove="client-app\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="recipes\**\*">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Build Angular app before the .NET build (Release only) -->
  <Target Name="BuildAngular" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
  </Target>

  <!-- Ensure Angular is built during publish -->
  <Target Name="PublishAngular" AfterTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
  </Target>

</Project>
